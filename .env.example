# Okta OAuth Service App (example values only)
OKTA_ISSUER=https://{yourOktaDomain}/oauth2/default
OKTA_CLIENT_ID=your-client-id
# Path to private JWK file (DO NOT COMMIT the actual file)
OKTA_PRIVATE_JWK_PATH=private_jwk.json

# App settings
APP_BIND_ADDRESS=127.0.0.1:8080
GLOBAL_GROUP=Example-Group

# Optional: SMTP / email settings (example placeholders)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notify@example.com
SMTP_PASS=changeme
# Okta tenant, no trailing slash
OKTA_DOMAIN=https://your-org.okta.com

# Recommended: OAuth 2.0 Service App
OKTA_AUTH_MODE=oauth
OKTA_CLIENT_ID=YOUR_SERVICE_APP_CLIENT_ID
OKTA_PRIVATE_JWK_FILE=/run/secrets/okta_private_jwk.json
# User create/lifecycle + list/manage group memberships
OKTA_SCOPES=okta.users.manage okta.groups.manage

# Temporary fallback only (set OKTA_AUTH_MODE=ssws)
# OKTA_TOKEN=YOUR_SSWS_API_TOKEN

# Delay between rows during write operations
SEND_DELAY_SECONDS=1.0
API_RETRY_429=2

# Optional web Basic Auth (recommended even behind ZPA)
WEB_USERNAME=admin
WEB_PASSWORD=change-me
