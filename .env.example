# Okta tenant, no trailing slash
OKTA_DOMAIN=https://your-org.okta.com

OKTA_AUTH_MODE=ssws
OKTA_TOKEN=PUT_YOUR_OKTA_API_TOKEN_HERE

# Delay between rows during write operations
SEND_DELAY_SECONDS=1.0
API_RETRY_429=2

WEB_USERNAME=admin
# Generate with: docker compose run --rm web python tools/hash_password.py
WEB_PASSWORD_HASH_B64=PASTE_PASSWORD_HASH_HERE
